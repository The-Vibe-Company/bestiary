# Variables d'environnement du jeu, sans aucune valeur secrète.
# En local : vercel env pull .env.local (ou copiez ce fichier vers .env.local et remplissez-le).
# Ne mettez jamais de vraie valeur dans ce fichier : il est dans le dépôt.

# Adresse de la base Postgres (Neon), avec son mot de passe.
DATABASE_URL=

# Facultatif : connexion directe, sans pool, utilisée par les migrations quand elle existe.
DATABASE_URL_UNPOOLED=

# Le secret que la tâche planifiée de Vercel envoie à /taches/temps. Sans lui, la tâche refuse tout appel.
CRON_SECRET=

# Facultatif, jamais en production : vitesse du temps du jeu (100 = une minute réelle vaut cent minutes).
BESTIA_VITESSE_TEMPS=

# Le mot de passe de la page de contrôle /controle (le nom saisi ne compte pas). Sans lui, la page reste fermée.
CONTROLE_MOT_DE_PASSE=

# Le secret qui chiffre les empreintes gardées pour freiner les abus : la connexion réseau des
# inscriptions, et les adresses e-mail essayées à la connexion.
EMPREINTE_RESEAU_SECRET=

# La clé de Resend, pour que les e-mails partent en production et en prévisualisation (voir The-Vibe-Company/bestiary#58).
# Inutile en local : les e-mails s'y affichent dans le journal.
RESEND_API_KEY=

# Facultatif : l'adresse du site dans les liens des e-mails (par défaut, celle que donne Vercel ;
# en local, http://localhost:3000).
BESTIA_ADRESSE_SITE=
